<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div style="display: flex; height: 100vh; font-family: sans-serif;">
        <!-- Sidebar -->
        <aside style="width: 250px; background: #2c3e50; color: white; padding: 20px;">
            <h2>Church Admin</h2>
            <ul style="list-style: none; padding: 0; margin-top: 20px;">
                <li style="margin-bottom: 10px;"><a href="/admin/dashboard" style="color: white; text-decoration: none;">Dashboard</a></li>
                <li><a href="/" style="color: #bdc3c7; text-decoration: none;">View Site</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main style="flex: 1; background: #ecf0f1; padding: 30px;">
            <h1>Welcome to the Admin Dashboard</h1>
            <p>Manage your church members, events, and settings here.</p>
            
            <div style="display: flex; gap: 20px; margin-top: 20px;">
                <div style="background: white; padding: 20px; border-radius: 5px; flex: 1; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                    <h3>Total Members</h3>
                    <p style="font-size: 24px; font-weight: bold; color: #2c3e50;">150</p>
                </div>
                <div style="background: white; padding: 20px; border-radius: 5px; flex: 1; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                    <h3>Upcoming Events</h3>
                    <p style="font-size: 24px; font-weight: bold; color: #2c3e50;">3</p>
                </div>
            </div>
        </main>
    </div>
</body>
</html>