<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('partials/header') %>


    <%- include('partials/navbar') %>
<main>

<section class="hero">

  <div class="hero-content">

    <span class="eyebrow">WELCOME HOME</span>

    <h1>Growing in Christ.<br>Serving with Love.</h1>

    <p>A welcoming church community where faith, fellowship and service come together.</p>

    <div class="actions">
      <a class="btn" href="/sermons">Watch Sermons</a>
      <a class="btn outline" href="contact">Join Us</a>
    </div>

  </div>

</section>
<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">THIS WEEK</span>
      <h2>Join us in worship</h2>

    </div>
  </div>

<div class="cards three">

  <article class="card">
    <div class="icon">☀</div>
    <h3>Sunday Worship</h3>
    <p>Every Sunday · 8:00 AM & 10:00 AM</p>
  </article>

  <article class="card">
    <div class="icon">📖</div>

    <h3>Bible Study</h3>
    <p>Wednesday · 5:30 PM</p>
  </article>

  <article class="card">
    <div class="icon">🙏</div>
    <h3>Prayer Meeting</h3>
    <p>Friday · 6:00 PM</p>
  </article>

</div>
</section>

<section class="section alt">
  <div class="split">
    <div>
      <span class="eyebrow">OUR COMMUNITY</span>
      <h2>A place to belong, believe and become.</h2>
      <p>We exist to help people know Christ, grow in faith and serve their community with compassion.</p>
      <a class="text-link" href="about">Learn more about us →</a>
    </div>
    <div class="quote">“Let all that you do be done in love.”<small>1 Corinthians 16:14</small>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      
      <span class="eyebrow">LATEST</span>
      <h2>Latest sermons</h2>
    </div>
    <a class="text-link" href="/sermons">View all →</a>
  
  </div><div class="cards three">

  <article class="card"><span class="tag">Faith</span>
    <h3>Walking by Faith</h3>
    <p>Sunday message · Pastor</p>
  </article>

  <article class="card">
    <span class="tag">Prayer</span>
    <h3>The Power of Prayer</h3>
    <p>Wednesday message · Pastor</p>
  </article>
  <article class="card">
    <span class="tag">Hope</span>
    <h3>Hope in Every Season</h3>
    <p>Sunday message · Pastor</p>
  </article>

</div>

</section>

</main>


<%- include('partials/footer') %>






<div id="toast" class="toast"></div>

<script src="js/script.js"></script>
    
</body>
</html>
