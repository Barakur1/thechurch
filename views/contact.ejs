<main>
     <section class="page-hero">
        <span class="eyebrow">CONTACT</span>
        <h1>We'd love to hear from you</h1>
        <p>Come worship with us or send us a message.</p>
    </section>
     <section class="section">
        <div class="split">
            <div>
                <h2>Visit us</h2>
                <p><strong>Address:</strong> Your Church Address</p>
                <p><strong>Phone:</strong> +234 000 000 0000</p>
                <p><strong>Email:</strong> hello@yourchurch.org</p>
                <p><strong>Services:</strong> Sunday 8:00 AM & 10:00 AM</p>
            </div>
                <form class="form" onsubmit="submitForm(event,'Thank you! Your message has been received.')">
                    <label>Name<input required name="name">
                    </label>
                    <label>Email<input required type="email" name="email">
                    </label><label>Message<textarea required name="message" rows="6">

                    </textarea>
                </label>
                <button class="btn" type="submit">Send Message</button>
            </form>
        </div>
    </section>

     </main>
